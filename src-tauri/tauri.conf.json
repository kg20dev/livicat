{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Livicat",
  "version": "0.9.6",
  "identifier": "com.livicat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Livicat",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.youtube.com https://i.ytimg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QTJCOThCOTczOEIwODYKUldTR3NEaVhpN21pK1pEYk1aYnZ3UE8rcUdWZ1c3ZXQyZUZyZll5SWhmaHdYamNTRjRWVGxXbWUK",
      "endpoints": [
        "https://pub-2a6e7087960e444c858cbb8adfebe109.r2.dev/latest.json"
      ],
      "dialog": true
    }
  }
}
